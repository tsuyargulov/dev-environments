{
  "name": "{{PROJECT_NAME}}",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "SSH_PUBKEY": "{{GATEWAY_PUBKEY}}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest",
      "terragrunt": "latest",
      "installTerraformDocs": "latest"
    }
  },
  "mounts": [
    "source={{PROJECT_DIR}},target=/workspace,type=bind,consistency=cached"
  ],
  "remoteUser": "vscode",
  "workspaceFolder": "/workspace",
  "runArgs": [
    "--network", "devenv-net",
    "--label", "sshpiper.username={{PROJECT_NAME}}",
    "--label", "sshpiper.container_username=vscode",
    "--label", "sshpiper.port=22",
    "--label", "sshpiper.authorized_keys={{USER_PUBKEY_B64}}",
    "--label", "sshpiper.private_key={{GATEWAY_PRIVKEY_B64}}"
  ],
  "postCreateCommand": "python -m pip install --no-cache-dir awscli-local terraform-local",
  "postStartCommand": "sudo ssh-keygen -A && sudo /usr/sbin/sshd && git config --global credential.helper '!f() { echo username=git; echo password=$GIT_TOKEN; }; f' && git config --global user.email \"$GIT_USER_EMAIL\" && git config --global user.name \"$GIT_USER_NAME\" && [ -z \"$(ls -A /workspace)\" ] && git clone ${GIT_BRANCH:+--branch $GIT_BRANCH} \"$GIT_REPO\" /workspace || true",
  "remoteEnv": {
    "GIT_REPO": "{{GIT_REPO}}",
    "GIT_BRANCH": "{{GIT_BRANCH}}",
    "GIT_TOKEN": "${localEnv:GIT_TOKEN}",
    "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}",
    "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-python.python",
        "ms-python.black-formatter"
      ]
    }
  }
}
